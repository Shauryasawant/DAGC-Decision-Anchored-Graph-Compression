import sys
sys.path.insert(0, "/Users/shaurya/python/dagc_pkg_v3_final/src")
from dagc.extraction import extract_decisions

variants = {
    "A: original full trace":
        "Ruled out Redis, too much memory pressure. Going with Memcached instead.",
    "B: decisive sentence alone (no preceding reject clause)":
        "Going with Memcached instead.",
    "C: B, but remove 'instead'":
        "Going with Memcached.",
    "D: B, but swap target for a mixed-case compound name":
        "Going with OpenAI instead.",
    "E: B, but swap target for a plain lowercase word":
        "Going with Postgres instead.",
    "F: canonical known-good phrasing as a sanity control":
        "Let's use Memcached instead.",
    "G: A, but give the reject clause an explicit first-person subject":
        "We ruled out Redis, too much memory pressure. Going with Memcached instead.",
    "H: known-good canonical example from taxonomy doc (should extract decision)":
        "Let's switch from MongoDB to PostgreSQL because we need joins.",
}

print("=" * 100)
print("BISECTION: extract_decisions() diagnostic")
print("=" * 100)
print()

results = {}
for label, text in variants.items():
    trace = [{"role": "user", "content": text}]
    decisions = extract_decisions(trace)
    ok = bool(decisions)
    results[label] = ok
    status = f"{len(decisions)} decision(s) FOUND" if ok else "0 decisions -- MISSED"
    print(f"{label}")
    print(f"  text: {text!r}")
    print(f"  -> {status}")
    for d in decisions:
        print(f"     full dict: {d}")
    print()

print("=" * 100)
print("SUMMARY")
print("=" * 100)
for label, ok in results.items():
    tag = label.split(":")[0]
    print(f"  {tag}: {'PASS' if ok else 'MISS'}")
print()

h_ok = results.get("H: known-good canonical example from taxonomy doc (should extract decision)")
if not h_ok:
    print(">>> STOP: Variant H (known-good phrasing) ALSO returned 0 decisions.")
    print(">>> The bug is NOT specific to reject-clauses or 'instead'.")
    print(">>> Something upstream is broken: wrong import path, stale .pyc,")
    print(">>> wrong function signature, or extract_decisions() itself regressed.")
else:
    a_ok = results.get("A: original full trace")
    b_ok = results.get("B: decisive sentence alone (no preceding reject clause)")
    if not a_ok and b_ok:
        print(">>> H passed, A failed, B passed: the reject-clause interferes with")
        print(">>> decision detection when in the SAME trace as the decisive clause.")
    elif not a_ok and not b_ok:
        print(">>> H passed, but A and B both failed: 'going with X instead' doesn't")
        print(">>> trigger decision detection at all -- a verb-coverage gap, not a")
        print(">>> same-message-exclusion issue.")
    elif a_ok:
        print(">>> H and A both passed: extract_decisions handles this fine already.")
        print(">>> The real failure is downstream, in rationale_ext.py or compressor.py's wiring.")
source .venv/bin/activate   # activates dagc_pkg_v3_final's own venv
python bisect_extract_decisions.py


